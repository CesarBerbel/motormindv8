SECRET_KEY=change-me-in-production
# Opcional em desenvolvimento (deriva da SECRET_KEY se vazia). Obrigatorio definir em producao.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Email em desenvolvimento imprime no console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MotorMind <no-reply@localhost>

# Exemplo para SMTP real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seudominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario@seudominio.com
# EMAIL_HOST_PASSWORD=sua-senha
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Producao / VPS
# Veja .env.production.example e docs/DEPLOY_HOSTINGER_VPS.md
CSRF_TRUSTED_ORIGINS=
SECURE_PROXY_SSL_HEADER=False
USE_X_FORWARDED_HOST=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL opcional para homologacao/producao.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=motormind
# DB_USER=motormind
# DB_PASSWORD=senha-forte-do-banco
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_SSL_REQUIRE=False

# Seguranca de login/sessao.
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
PASSWORD_RESET_TIMEOUT=3600
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
