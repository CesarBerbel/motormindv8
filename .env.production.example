# Copie este arquivo para .env na VPS e ajuste os valores.
# Nunca versione o arquivo .env real.

SECRET_KEY=gere-uma-chave-grande-e-unica
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com,SEU_IP_DA_VPS
CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Banco de dados recomendado em producao: PostgreSQL.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=motormind
DB_USER=motormind
DB_PASSWORD=senha-forte-do-banco
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# Alternativa local/desenvolvimento com SQLite:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/var/www/motormind/current/db.sqlite3

# Nginx encaminha HTTPS para Gunicorn por HTTP local.
SECURE_PROXY_SSL_HEADER=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY

# Seguranca de sessao e login.
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
PASSWORD_RESET_TIMEOUT=3600
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Email em producao. Necessario para recuperacao de senha.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seudominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=usuario@seudominio.com
EMAIL_HOST_PASSWORD=sua-senha
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=MotorMind <no-reply@seudominio.com>
