{
  "id": "/dashboard/",
  "name": "MotorMind",
  "short_name": "MotorMind",
  "description": "Sistema de gestão de oficina MotorMind.",
  "lang": "pt-BR",
  "start_url": "/dashboard/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#1f2937",
  "theme_color": "#1f2937",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Abrir o painel principal do MotorMind.",
      "url": "/dashboard/?source=pwa-shortcut",
      "icons": [{ "src": "/static/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Kanban técnico",
      "short_name": "Kanban",
      "description": "Abrir a área técnica da oficina.",
      "url": "/mecanica/kanban/?source=pwa-shortcut",
      "icons": [{ "src": "/static/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pedidos do site",
      "short_name": "Pedidos",
      "description": "Ver pedidos de orçamento recebidos pelo site.",
      "url": "/painel/orcamentos/?source=pwa-shortcut",
      "icons": [{ "src": "/static/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/static/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
